<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>台北小旅行 5/15–5/18</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;900&family=DM+Serif+Display:ital@0;1&family=Noto+Sans+TC:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root{--ink:#1a1714;--paper:#f7f3ee;--paper2:#ede8e1;--accent:#c8502a;--gold:#b8923a;--muted:#7a7268;--teal:#2a6b5e;--purple:#5a4878;--serif:'DM Serif Display','Noto Serif TC',serif;--sans:'Noto Sans TC',sans-serif;}
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.65;min-height:100vh;}
  header{background:var(--ink);color:var(--paper);padding:48px 24px 36px;position:relative;overflow:hidden;}
  header::before{content:'';position:absolute;top:-60px;right:-60px;width:220px;height:220px;border-radius:50%;border:1px solid rgba(255,255,255,0.07);}
  header::after{content:'';position:absolute;bottom:-40px;left:-30px;width:140px;height:140px;border-radius:50%;border:1px solid rgba(255,255,255,0.05);}
  .header-label{font-weight:300;font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(247,243,238,0.45);margin-bottom:10px;}
  header h1{font-family:var(--serif);font-size:40px;font-weight:400;line-height:1.15;margin-bottom:4px;}
  header h1 em{font-style:italic;color:rgba(247,243,238,0.55);font-size:0.68em;}
  .header-dates{font-size:12px;font-weight:300;color:rgba(247,243,238,0.5);margin-top:14px;display:flex;align-items:center;gap:8px;}
  .header-dates span{display:inline-block;width:20px;height:1px;background:rgba(247,243,238,0.25);}
  .hotel-strip{background:var(--ink);border-top:1px solid rgba(255,255,255,0.07);padding:14px 24px;display:flex;align-items:flex-start;gap:10px;color:rgba(247,243,238,0.6);font-size:12px;font-weight:300;line-height:1.5;}
  .hotel-icon{font-size:14px;opacity:0.5;flex-shrink:0;margin-top:1px;}
  .hotel-strip strong{display:block;color:rgba(247,243,238,0.85);font-weight:500;font-size:13px;margin-bottom:1px;}
  .transport-strip{background:var(--paper2);border-bottom:1px solid rgba(26,23,20,0.08);padding:11px 24px;display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--muted);font-weight:300;}
  .transport-strip .rdot{width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
  .days{padding:8px 0 40px;}
  .day-card{margin:18px 14px 0;border-radius:18px;overflow:hidden;box-shadow:0 2px 14px rgba(26,23,20,0.08);opacity:0;transform:translateY(18px);transition:opacity 0.5s ease,transform 0.5s ease;}
  .day-card.visible{opacity:1;transform:translateY(0);}
  .day-header{padding:18px 20px 16px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px;}
  .day-header.teal{background:var(--teal);color:var(--paper);}
  .day-header.purple{background:var(--purple);color:var(--paper);}
  .day-header.gold{background:var(--gold);color:var(--paper);}
  .day-header.ink{background:var(--ink);color:var(--paper);}
  .day-date{font-family:var(--serif);font-size:30px;font-weight:400;line-height:1;}
  .day-weekday{font-size:10.5px;font-weight:300;letter-spacing:0.13em;opacity:0.6;margin-top:5px;}
  .day-tag{font-size:11px;font-weight:400;letter-spacing:0.07em;background:rgba(255,255,255,0.14);padding:4px 11px;border-radius:20px;margin-top:4px;white-space:nowrap;}
  .day-body{background:#fff;}
  .event{padding:15px 18px;display:flex;gap:14px;border-bottom:1px solid var(--paper2);}
  .event:last-child{border-bottom:none;}
  .event-time{font-size:11px;font-weight:500;color:var(--muted);letter-spacing:0.05em;min-width:38px;padding-top:3px;flex-shrink:0;line-height:1.2;}
  .event-dot{width:8px;height:8px;border-radius:50%;margin-top:5px;flex-shrink:0;}
  .dot-teal{background:var(--teal);}
  .dot-purple{background:var(--purple);}
  .dot-gold{background:var(--gold);}
  .dot-accent{background:var(--accent);}
  .dot-muted{background:var(--muted);opacity:0.35;}
  .event-content{flex:1;min-width:0;}
  .event-title{font-weight:500;font-size:14.5px;line-height:1.35;color:var(--ink);margin-bottom:2px;}
  .event-sub{font-size:12px;color:var(--muted);font-weight:300;line-height:1.55;}
  .event-addr{font-size:11px;color:var(--muted);margin-top:5px;display:flex;align-items:flex-start;gap:4px;opacity:0.7;line-height:1.4;}
  .event-addr::before{content:'◎';font-size:10px;flex-shrink:0;margin-top:1px;}
  .restaurant-section{background:#fff;border-top:1px solid var(--paper2);}
  .restaurant-section-header{padding:14px 18px 10px;display:flex;align-items:center;gap:8px;font-size:11px;font-weight:500;letter-spacing:0.1em;color:var(--muted);text-transform:uppercase;border-bottom:1px dashed var(--paper2);}
  .restaurant-section-header::before{content:'';display:inline-block;width:3px;height:12px;background:var(--accent);border-radius:2px;}
  .resto-card{padding:14px 18px;border-bottom:1px solid var(--paper2);display:flex;flex-direction:column;gap:5px;}
  .resto-card:last-child{border-bottom:none;}
  .resto-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;}
  .resto-name{font-weight:500;font-size:14px;color:var(--ink);line-height:1.3;flex:1;}
  .resto-type{font-size:10.5px;font-weight:400;color:var(--muted);background:var(--paper2);padding:2px 8px;border-radius:10px;white-space:nowrap;flex-shrink:0;margin-top:2px;}
  .resto-meta{display:flex;flex-wrap:wrap;gap:6px 12px;font-size:11.5px;color:var(--muted);font-weight:300;}
  .resto-meta-item{display:flex;align-items:center;gap:4px;}
  .resto-meta-item .icon{font-size:11px;opacity:0.6;}
  .resto-links{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;}
  .resto-link{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:400;padding:4px 10px;border-radius:20px;text-decoration:none;transition:opacity 0.15s;}
  .resto-link:active{opacity:0.7;}
  .link-map{background:#e8f0e9;color:#2a6b5e;}
  .link-book{background:#ede8f5;color:var(--purple);}
  .link-order{background:#fce8e2;color:var(--accent);}
  .event.gallery-highlight{background:linear-gradient(135deg,#f5f0eb 0%,#ede8e1 100%);border-left:3px solid var(--gold);padding-left:15px;}
  .event.gallery-highlight .event-title{color:#7a5c1e;}
  .event.concert-highlight{background:linear-gradient(135deg,#f4f0fa 0%,#ede8f5 100%);border-left:3px solid var(--purple);padding-left:15px;}
  .event.concert-highlight .event-title{color:var(--purple);font-size:15px;}
  .tbd-note{padding:22px 20px;text-align:center;color:var(--muted);font-size:12.5px;font-weight:300;border-bottom:1px dashed var(--paper2);}
  .tbd-note strong{display:block;font-family:var(--serif);font-size:24px;font-weight:400;color:rgba(26,23,20,0.2);margin-bottom:5px;}
  .people-pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:400;background:rgba(255,255,255,0.13);padding:3px 10px;border-radius:20px;margin-top:8px;opacity:0.8;}
  .badge{display:inline-block;font-size:10px;font-weight:500;letter-spacing:0.07em;padding:2px 8px;border-radius:10px;margin-left:5px;vertical-align:middle;}
  .badge-accent{background:#fce8e2;color:var(--accent);}
  .badge-tbd{background:var(--paper2);color:var(--muted);}
  .badge-gold{background:#f5edd8;color:#7a5c1e;}
  .connector{display:flex;align-items:center;padding:9px 28px;gap:10px;color:var(--muted);font-size:11px;font-weight:300;letter-spacing:0.08em;}
  .connector::before,.connector::after{content:'';flex:1;height:1px;background:var(--paper2);}
  .night-tip{background:var(--paper2);padding:11px 18px;font-size:11.5px;color:var(--muted);font-weight:300;display:flex;align-items:flex-start;gap:7px;border-top:1px solid rgba(26,23,20,0.06);}
  .night-tip::before{content:'★';font-size:10px;flex-shrink:0;margin-top:2px;opacity:0.5;}
  .hours-box{margin-top:6px;background:rgba(184,146,58,0.08);border-radius:6px;padding:6px 9px;font-size:11px;color:#7a5c1e;line-height:1.5;}
  .hours-box span{opacity:0.7;}
  footer{padding:28px 24px 52px;text-align:center;color:var(--muted);font-size:12px;font-weight:300;border-top:1px solid var(--paper2);}
  footer p+p{margin-top:4px;}
  footer .footer-hotel{margin-top:10px;font-size:11px;opacity:0.6;}
</style>
</head>
